{
  "name": "code-cat-cafe",
  "version": "0.2.0",
  "private": true,
  "description": "A pixel cat office that shows your Claude Code agents at work.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && node bridge/server.js --open",
    "dev": "concurrently -k -n bridge,web -c yellow,cyan \"node bridge/server.js\" \"vite web\"",
    "build": "vite build web",
    "setup": "node bridge/setup-hooks.js",
    "sample": "node bridge/send-sample.js",
    "typecheck": "tsc --noEmit -p web",
    "test": "node --test bridge/bridge.test.js",
    "prepare": "vite build web",
    "doctor": "node bin/code-cat-office.js doctor"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "bin": {
    "code-cat-office": "bin/code-cat-office.js"
  },
  "files": [
    "bin",
    "bridge",
    "!bridge/*.test.js",
    "web/dist",
    "team-kit",
    "docs/screenshot.png",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfqnet/code-cat-cafe.git"
  },
  "keywords": [
    "claude-code",
    "hooks",
    "agents",
    "visualizer",
    "pixel-art",
    "dashboard"
  ]
}
